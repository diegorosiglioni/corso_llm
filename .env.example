LMSTUDIO_MODEL=google/gemma-4-e2b
MAX_STEPS=5
MAX_REVIEWS=2
SUMMARY_MAX_MESSAGES=20
SUMMARY_KEEP_MESSAGES=6
LOG_LEVEL=INFO
# Archivio SQLite delle note (default, relativo alla cartella di avvio):
# NOTES_DB=data/notes.sqlite3
# File con l'ambito dell'assistente (default: quello del pacchetto, assistant/data/scope.txt):
# SCOPE_FILE=assistant/data/scope.txt
# File delle preferenze dell'utente (default: quello del pacchetto, assistant/data/preferenze.json):
# PREFERENCES_FILE=assistant/data/preferenze.json
# Indirizzo e porta del servizio HTTP dell'agente (python -m assistant.service; default):
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8000
# Indirizzo del servizio dell'agente per la CLI (python -m assistant; default; in Docker lo
# imposta compose.yaml):
# AGENT_URL=http://127.0.0.1:8000
# Back-end (python -m backend): database PostgreSQL, obbligatorio; utente e password sono solo
# d'esempio, quelli veri restano nel file .env fuori da Git (anche postgresql://… è accettato):
# DATABASE_URL=postgresql+psycopg://utente:password@127.0.0.1:5432/assistente
# Indirizzo e porta del back-end (default; usa AGENT_URL per raggiungere l'agente):
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8001
# Origini delle pagine del front-end ammesse dal back-end (CORS; default):
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Front-end (python -m frontend): indirizzo del back-end visto dal browser, indirizzo e porta
# della pagina (default):
# BACKEND_URL=http://127.0.0.1:8001
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=8080
# Solo per Docker, se LM Studio non è raggiungibile su host.docker.internal:1234:
# LMSTUDIO_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
