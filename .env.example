LMSTUDIO_MODEL=google/gemma-4-e2b
MAX_STEPS=5
MAX_REVIEWS=2
LOG_LEVEL=INFO
# Archivio SQLite delle note (default, relativo alla cartella di avvio):
# NOTES_DB=data/notes.sqlite3
# File con l'ambito dell'assistente (default: quello del pacchetto, assistant/data/scope.txt):
# SCOPE_FILE=assistant/data/scope.txt
# Solo per Docker, se LM Studio non è raggiungibile su host.docker.internal:1234:
# LMSTUDIO_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
