{
  "openapi": "3.1.0",
  "info": {
    "title": "Assistente del laboratorio — back-end",
    "description": "Chat salvate nel database: creazione, elenco, lettura, invio di un messaggio all'agente ed eliminazione. È l'unico servizio che il front-end usa; l'agente si raggiunge solo da qui.",
    "version": "0.1.0"
  },
  "paths": {
    "/chats": {
      "get": {
        "summary": "Elenca le chat",
        "description": "Tutte le chat con titolo e data dell'ultimo messaggio, dalla più recente (ultimo messaggio o, per una chat vuota, creazione).",
        "operationId": "list_chats_chats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatInfo"
                  },
                  "type": "array",
                  "title": "Response List Chats Chats Get"
                }
              }
            }
          },
          "500": {
            "description": "Errore imprevisto (internal_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Database non disponibile (database_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crea una chat",
        "description": "Crea una chat vuota, con il titolo dato oppure senza: in quel caso il titolo arriva dalla prima domanda. Il corpo è facoltativo.",
        "operationId": "create_chat_chats_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CreateChatRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatInfo"
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida (invalid_request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Errore imprevisto (internal_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Database non disponibile (database_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{chat_id}": {
      "get": {
        "summary": "Legge una chat",
        "description": "La chat con tutti i suoi messaggi in ordine cronologico.",
        "operationId": "get_chat_chats__chat_id__get",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Chat Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatDetail"
                }
              }
            }
          },
          "404": {
            "description": "Chat inesistente (chat_not_found).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Errore imprevisto (internal_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Database non disponibile (database_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Elimina una chat",
        "description": "Elimina la chat e tutti i suoi messaggi.",
        "operationId": "delete_chat_chats__chat_id__delete",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Chat Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Chat inesistente (chat_not_found).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Errore imprevisto (internal_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Database non disponibile (database_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chats/{chat_id}/messages": {
      "post": {
        "summary": "Invia un messaggio",
        "description": "Salva la domanda, la manda all'agente con la cronologia e il riassunto della chat, poi salva e restituisce la risposta con gli strumenti usati. Se l'agente non risponde la domanda resta nella chat senza risposta e la cronologia dell'agente non cambia.",
        "operationId": "send_message_chats__chat_id__messages_post",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Chat Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida (invalid_request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Chat inesistente (chat_not_found).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Errore imprevisto (internal_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "L'agente ha risposto con un errore (agent_error).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Agente non raggiungibile (agent_unavailable) o database non disponibile (database_unavailable).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "504": {
            "description": "L'agente non ha risposto entro il tempo massimo (agent_timeout).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Identificativo della chat."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Titolo della chat ('Nuova chat' finché non ne ha uno)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Data di creazione (ISO 8601, UTC)."
          },
          "last_message_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message At",
            "description": "Data dell'ultimo messaggio (ISO 8601, UTC); null se la chat è vuota."
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageInfo"
            },
            "type": "array",
            "title": "Messages",
            "description": "Messaggi della chat in ordine cronologico."
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "last_message_at",
          "messages"
        ],
        "title": "ChatDetail"
      },
      "ChatInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Identificativo della chat."
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Titolo della chat ('Nuova chat' finché non ne ha uno)."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Data di creazione (ISO 8601, UTC)."
          },
          "last_message_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Message At",
            "description": "Data dell'ultimo messaggio (ISO 8601, UTC); null se la chat è vuota."
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "last_message_at"
        ],
        "title": "ChatInfo"
      },
      "ChatMessageInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Identificativo del messaggio (cresce con l'ordine di invio)."
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "description": "'user' domanda, 'assistant' risposta."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Testo del messaggio."
          },
          "tools_used": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Tools Used",
            "description": "Strumenti usati dall'agente per la risposta (name, args, result, ok); vuoto per le domande."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Data del messaggio (ISO 8601, UTC)."
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "tools_used",
          "created_at"
        ],
        "title": "ChatMessageInfo"
      },
      "CreateChatRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Titolo della chat (al più 200 caratteri). Se manca, lo dà la prima domanda."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateChatRequest",
        "examples": [
          {
            "title": "Conversioni di unità"
          },
          {}
        ]
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Codice stabile dell'errore."
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Messaggio in italiano."
          }
        },
        "type": "object",
        "required": [
          "error",
          "detail"
        ],
        "title": "ErrorBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SendMessageRequest": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Domanda dell'utente; gli spazi iniziali e finali si tolgono e non può restare vuota."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "SendMessageRequest",
        "examples": [
          {
            "content": "Quanto fa 17 * 23?"
          }
        ]
      },
      "SendMessageResponse": {
        "properties": {
          "question": {
            "$ref": "#/components/schemas/ChatMessageInfo",
            "description": "La domanda salvata."
          },
          "answer": {
            "$ref": "#/components/schemas/ChatMessageInfo",
            "description": "La risposta dell'agente salvata."
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "SendMessageResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
